{
  "hosting": {
    "site": "pratikkhairnarsec",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      ".git/**",
      "**/node_modules/**",
      "scripts/**",
      "README.md",
      "RESUME.md"
    ],
    "headers": [
      {
        "source": "**/*.@(pdf|html|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
