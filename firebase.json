{
  "hosting": {
    "site": "pratikkhairnarsec",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      ".git/**",
      "**/node_modules/**",
      "scripts/**",
      "README.md",
      "RESUME.md"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|woff2|woff)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(pdf|html|txt|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/assets/Pratik_Khairnar_Official_VAPT_Resume_2026.pdf",
        "destination": "/assets/Pratik_Khairnar_Resume.pdf",
        "type": 301
      },
      {
        "source": "/assets/pratik_khairnar_resume.pdf",
        "destination": "/assets/Pratik_Khairnar_Resume.pdf",
        "type": 301
      }
    ]
  }
}
